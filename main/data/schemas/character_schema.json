{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Character Class Schema",
    "type": "object",
    "required": ["id", "name", "description", "stats"],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the character class"
      },
      "name": {
        "type": "string",
        "description": "Display name of the character class"
      },
      "description": {
        "type": "string",
        "description": "Description of the character class"
      },
      "stats": {
        "type": "object",
        "properties": {
          "hp": { "type": "integer", "minimum": 1 },
          "hp_limit": { "type": "integer", "minimum": 1 },
          "defence_points": { "type": "integer", "minimum": 0 },
          "strength": { "type": "integer", "minimum": 0 },
          "gun_skill": { "type": "integer", "minimum": 0 },
          "luck": { "type": "integer", "minimum": 0, "maximum": 7 },
          "charm": { "type": "integer", "minimum": 0, "maximum": 7 },
          "stealth": { "type": "integer", "minimum": 0, "maximum": 7 }
        },
        "required": ["hp", "hp_limit", "defence_points", "strength", "gun_skill", "luck", "charm", "stealth"]
      },
      "starting_inventory": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Item IDs in starting inventory"
      }
    }
  }