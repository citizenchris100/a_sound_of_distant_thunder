{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dialog Tree Schema",
  "type": "object",
  "required": ["id", "start_node", "nodes"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this dialog tree"
    },
    "start_node": {
      "type": "string",
      "description": "ID of the starting node in this dialog tree"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "oneOf": [
          {
            "required": ["text", "options"],
            "properties": {
              "text": {
                "type": "string",
                "description": "Text displayed for this node"
              },
              "condition": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "type": "string" },
                      "params": { "type": "object" }
                    }
                  }
                ],
                "description": "Condition that must be met for this node"
              },
              "fallback": {
                "type": "string",
                "description": "Node to go to if condition fails"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "text"],
                  "properties": {
                    "id": { "type": "string" },
                    "text": { "type": "string" },
                    "suspicion_effect": { "type": "integer" },
                    "trust_effect": { "type": "integer" },
                    "next": { "type": "string" },
                    "action": {
                      "oneOf": [
                        { "type": "string" },
                        {
                          "type": "object",
                          "required": ["type"],
                          "properties": {
                            "type": { "type": "string" },
                            "params": { "type": "object" }
                          }
                        }
                      ]
                    },
                    "condition": {
                      "oneOf": [
                        { "type": "string" },
                        {
                          "type": "object",
                          "required": ["type"],
                          "properties": {
                            "type": { "type": "string" },
                            "params": { "type": "object" }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "required": ["text", "responses"],
            "properties": {
              "text": { "type": "string" },
              "responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text"],
                  "properties": {
                    "text": { "type": "string" },
                    "next": { "type": "string" }
                  }
                }
              }
            }
          },
          {
            "required": ["text", "next"],
            "properties": {
              "text": { "type": "string" },
              "next": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}