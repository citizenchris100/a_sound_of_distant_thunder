{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item Schema",
  "type": "object",
  "required": ["id", "name", "description", "type"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the item"
    },
    "name": {
      "type": "string",
      "description": "Display name of the item"
    },
    "description": {
      "type": "string",
      "description": "Description of the item"
    },
    "type": {
      "type": "string",
      "enum": ["weapon", "melee", "armor", "consumable", "key", "quest", "goo"],
      "description": "Type of item"
    },
    "value": {
      "type": "integer",
      "minimum": 0,
      "description": "Base value/effectiveness of the item"
    },
    "uses": {
      "type": "integer",
      "minimum": -1,
      "description": "Number of uses (-1 for infinite)"
    },
    "ammo": {
      "type": "integer",
      "minimum": 0,
      "description": "Ammunition for weapons"
    },
    "ammo_capacity": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum ammunition capacity"
    },
    "effects": {
      "type": "object",
      "description": "Effects when using this item"
    }
  }
}