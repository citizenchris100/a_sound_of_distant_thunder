{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Location Schema",
  "type": "object",
  "required": ["id", "name", "description"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the location"
    },
    "name": {
      "type": "string",
      "description": "Display name of the location"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the location"
    },
    "district": {
      "type": "string",
      "enum": ["shipping", "mall", "commerce", "barracks", "engineering"],
      "description": "Station district this location belongs to"
    },
    "connections": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of locations directly connected to this one"
    },
    "npcs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of NPCs present in this location"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { 
              "type": "string",
              "enum": ["look", "take", "use", "talk"]
            }
          }
        }
      },
      "description": "Interactive objects in this location"
    },
    "first_visit_events": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Events triggered on first visit"
    },
    "revisit_events": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Events triggered when revisiting"
    }
  }
}