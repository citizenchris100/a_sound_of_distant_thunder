{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPC Schema",
  "type": "object",
  "required": ["id", "name", "description"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the NPC"
    },
    "name": {
      "type": "string",
      "description": "Display name of the NPC"
    },
    "description": {
      "type": "string",
      "description": "Physical description and background of the NPC"
    },
    "health": {
      "type": "integer",
      "minimum": 1,
      "default": 100,
      "description": "Current health points"
    },
    "defense": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Defense points that reduce damage"
    },
    "strength": {
      "type": "integer",
      "minimum": 0,
      "default": 5,
      "description": "Physical strength attribute"
    },
    "gun_skill": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Ranged combat skill"
    },
    "luck": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "default": 0,
      "description": "Luck attribute affecting random outcomes"
    },
    "awareness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "default": 0,
      "description": "Awareness attribute affecting detection abilities"
    },
    "initial_trust": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "description": "Initial trust level toward the player"
    },
    "is_assimilated": {
      "type": "boolean",
      "default": false,
      "description": "Whether the NPC has been assimilated by the alien goo"
    },
    "behavior_pattern": {
      "type": "string",
      "enum": ["neutral", "friendly", "wary", "hostile", "assimilated"],
      "default": "neutral",
      "description": "Base behavior pattern of the NPC"
    },
    "persistent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the NPC persists across location changes"
    },
    "schedule": {
      "type": "object",
      "properties": {
        "morning": { "type": "string" },
        "afternoon": { "type": "string" },
        "evening": { "type": "string" }
      },
      "description": "NPC's location schedule throughout the day"
    },
    "inventory": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Item IDs in the NPC's inventory"
    },
    "dialog_trees": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Dialog tree IDs available for this NPC"
    },
    "equipped_weapon": {
      "type": ["string", "null"],
      "description": "ID of equipped ranged weapon"
    },
    "equipped_melee": {
      "type": ["string", "null"],
      "description": "ID of equipped melee weapon"
    },
    "equipped_armor": {
      "type": ["string", "null"],
      "description": "ID of equipped armor"
    }
  }
}