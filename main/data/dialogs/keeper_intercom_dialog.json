{
    "dialog_nodes": {
      "keeper_intercom_initial": {
        "npc_text": "*STATIC* ...Who's there? What do you want?",
        "player_choices": [
          {
            "choice_id": "need_help",
            "choice_text": "Hello! I was just attacked by some kind of... thing? I really need some help.",
            "destination_node": "keeper_asks_for_loot",
            "conditions": [],
            "effects": []
          },
          {
            "choice_id": "demand_entry",
            "choice_text": "Open this door, now!",
            "destination_node": "keeper_refuses_rudely",
            "conditions": [],
            "effects": [
              {"effect_type": "change_fondness", "amount": -1}
            ]
          },
          {
            "choice_id": "introduce_self",
            "choice_text": "I'm Alex. I just arrived by boat and need somewhere safe.",
            "destination_node": "keeper_still_asks_for_loot",
            "conditions": [],
            "effects": []
          }
        ]
      },
      "keeper_asks_for_loot": {
        "npc_text": "I saw you heading in from that freighter offshore. So, you get anything off your attacker?",
        "player_choices": [
          {
            "choice_id": "maybe_what_to_you",
            "choice_text": "Maybe. What's it to you?",
            "destination_node": "keeper_charm_check",
            "conditions": [],
            "effects": [
              {"effect_type": "perform_check", "check_type": "charm_persuasion", "success_node": "keeper_approves_charm", "failure_node": "keeper_demands_respect"}
            ]
          },
          {
            "choice_id": "please_let_in",
            "choice_text": "Could you please let me in? I need some help, man.",
            "destination_node": "keeper_explains_barter",
            "conditions": [],
            "effects": []
          },
          {
            "choice_id": "got_vial",
            "choice_text": "Sure thing, old timer. The thing I killed had a vial of some kind of drug on it.",
            "destination_node": "keeper_grants_entry",
            "conditions": [
              {"condition_type": "check_flag", "flag_name": "npc_defeated_basic_goblin_01", "flag_value": true},
              {"condition_type": "check_item", "item_id": "small_ns_pack", "quantity": 1}
            ],
            "effects": []
          },
          {
            "choice_id": "nothing_found",
            "choice_text": "I didn't get anything off the body. Should I have?",
            "destination_node": "keeper_tells_to_check_body",
            "conditions": [
              {"condition_type": "check_flag", "flag_name": "npc_defeated_basic_goblin_01", "flag_value": true},
              {"condition_type": "check_item", "item_id": "small_ns_pack", "quantity": 0}
            ],
            "effects": []
          }
        ]
      },
      "keeper_approves_charm": {
        "npc_text": "You never know, stranger. Maybe quite a lot. Come on in.",
        "player_choices": [
          {
            "choice_id": "continue",
            "choice_text": "[CONTINUE]",
            "destination_node": "[END_CONVERSATION]",
            "conditions": [],
            "effects": [
              {"effect_type": "change_fondness", "amount": 1},
              {"effect_type": "set_flag", "flag_name": "lighthouse_access_granted", "flag_value": true}
            ]
          }
        ]
      },
      "keeper_demands_respect": {
        "npc_text": "Maybe a lot. Maybe nothing at all. The way I see it, you need me a helluva lot more than I need you. So show a little respect, stranger.",
        "player_choices": [
          {
            "choice_id": "apologize_with_vial",
            "choice_text": "Sure thing, old timer. You're the boss. The thing I killed had a vial of some kind of drug on it.",
            "destination_node": "keeper_grants_entry",
            "conditions": [
              {"condition_type": "check_flag", "flag_name": "npc_defeated_basic_goblin_01", "flag_value": true},
              {"condition_type": "check_item", "item_id": "small_ns_pack", "quantity": 1}
            ],
            "effects": []
          },
          {
            "choice_id": "apologize_no_vial",
            "choice_text": "Ok boss, you're in charge. I didn't get anything off the body. Should I have?",
            "destination_node": "keeper_tells_to_check_body",
            "conditions": [
              {"condition_type": "check_flag", "flag_name": "npc_defeated_basic_goblin_01", "flag_value": true}
            ],
            "effects": []
          }
        ]
      },
      "keeper_explains_barter": {
        "npc_text": "I don't help. I barter. If you happen to find any vials lying around, maybe we can talk. Otherwise, go away!",
        "player_choices": [
          {
            "choice_id": "have_vial",
            "choice_text": "The thing I killed had a vial of some kind of drug. Will that work?",
            "destination_node": "keeper_grants_entry",
            "conditions": [
              {"condition_type": "check_item", "item_id": "small_ns_pack", "quantity": 1}
            ],
            "effects": []
          },
          {
            "choice_id": "will_look",
            "choice_text": "I'll go check the body again.",
            "destination_node": "[END_CONVERSATION]",
            "conditions": [],
            "effects": []
          }
        ]
      },
      "keeper_grants_entry": {
        "npc_text": "I suppose. Don't you try anything or it might be the last mistake you make.",
        "player_choices": [
          {
            "choice_id": "continue",
            "choice_text": "[CONTINUE]",
            "destination_node": "[END_CONVERSATION]",
            "conditions": [],
            "effects": [
              {"effect_type": "set_flag", "flag_name": "lighthouse_access_granted", "flag_value": true}
            ]
          }
        ]
      },
      "keeper_tells_to_check_body": {
        "npc_text": "Maybe it's a good idea to take another look, stranger. You never know what you might find. Let's just say you need to bring something to the table before I'm even going to think about letting you in here.",
        "player_choices": [
          {
            "choice_id": "continue",
            "choice_text": "I'll check again.",
            "destination_node": "[END_CONVERSATION]",
            "conditions": [],
            "effects": []
          }
        ]
      },
      "keeper_refuses_rudely": {
        "npc_text": "You listen here, stranger. I've got no patience for your attitude. Find something worth trading or get lost!",
        "player_choices": [
          {
            "choice_id": "continue",
            "choice_text": "(Back away from the intercom)",
            "destination_node": "[END_CONVERSATION]",
            "conditions": [],
            "effects": []
          }
        ]
      }
    }
  }