{
    "type": "object",
    "properties": {
      "item_id": {
        "type": "string",
        "description": "Unique identifier for the item."
      },
      "name": {
        "type": "string",
        "description": "Display name of the item."
      },
      "description": {
        "type": "string",
        "description": "In-game description of the item."
      },
      "item_type": {
        "type": "string",
        "enum": ["weapon", "armor", "consumable", "ammo", "misc"],
        "description": "Category of the item."
      },
      "attributes": {
        "type": "object",
        "description": "Type-specific attributes.",
        "properties": {
        
        },
        "additionalProperties": true
      },
      "value": {
        "type": "integer",
        "description": "Base value of the item."
      },
      "icon": {
        "type": "string",
        "description": "Icon image path (optional).",
        "default": null
      },
      "max_durability": {
        "type": "integer",
        "description": "Maximum durability of the item when in perfect condition."
      },
      "current_durability": {
        "type": "integer",
