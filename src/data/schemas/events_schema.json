{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Schema",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the event"
    },
    "type": {
      "type": "string",
      "enum": ["spawn_npcs", "dialog", "combat", "modify_variable", "give_item", "custom"],
      "description": "Type of event"
    },
    "description": {
      "type": "string",
      "description": "Description of the event for debugging"
    },
    "npcs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "NPC IDs involved in this event"
    },
    "dialog_id": {
      "type": "string",
      "description": "ID of dialog to trigger"
    },
    "npc_id": {
      "type": "string",
      "description": "ID of NPC to interact with"
    },
    "enemies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Enemy IDs for combat"
    },
    "surprise": {
      "type": "boolean",
      "description": "Whether combat starts with surprise"
    },
    "variable": {
      "type": "string",
      "description": "Variable to modify"
    },
    "operation": {
      "type": "string",
      "enum": ["set", "increment", "decrement", "multiply"],
      "description": "Operation to perform on variable"
    },
    "value": {
      "description": "Value for variable operation"
    },
    "item_id": {
      "type": "string",
      "description": "ID of item to give"
    },
    "custom_action": {
      "type": "string",
      "description": "Name of custom action to execute"
    },
    "params": {
      "type": "object",
      "description": "Additional parameters for this event"
    }
  }
}